{%- liquid
  assign menu = section.settings.menu
  assign logo = section.settings.logo
-%}

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            width: section.settings.logo_width,
            alt: shop.name
        }}
      {%- else -%}
        <p class="footer__brand-text">{{ shop.name | escape }}</p>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="footer__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if menu != blank and menu.links.size > 0 -%}
      <nav class="footer__nav" aria-label="{{ 'accessibility.footer_navigation' | t }}">
        <ul class="footer__menu" role="list">
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  <div class="footer__bottom container">
    {%- if section.settings.copyright != blank -%}
      <p>{{ section.settings.copyright | escape }}</p>
    {%- else -%}
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "header", "content": "Brand" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to show the store name as text."
    },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 120 },
    { "type": "textarea", "id": "description", "label": "Short description" },

    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },

    { "type": "header", "content": "Copyright" },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "info": "Leave empty to show the year and store name."
    }
  ]
}
{% endschema %}
