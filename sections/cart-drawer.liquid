{%- comment -%}
  Cart drawer. Rendered once in layout/theme.liquid with {% section 'cart-drawer' %} and refreshed by
  assets/cart-drawer.js through the Section Rendering API, so Shopify's cart stays the single source of truth.
  Only the [data-cart-drawer-content] element is replaced on updates.
{%- endcomment -%}
<div
  class="drawer drawer--right cart-drawer"
  id="CartDrawer"
  data-drawer="cart"
  role="dialog"
  aria-modal="true"
  aria-labelledby="CartDrawerTitle"
  aria-hidden="true"
  data-add-url="{{ routes.cart_add_url }}"
  data-change-url="{{ routes.cart_change_url }}"
  data-update-url="{{ routes.cart_update_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-section-id="cart-drawer"
  data-error-text="{{ 'cart.error_generic' | t | escape }}"
>
  <div class="drawer__overlay" data-drawer-close></div>

  <div class="drawer__panel">
    <div class="drawer__header">
      <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <button class="icon-button" type="button" data-drawer-close data-drawer-focus aria-label="{{ 'cart.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <p class="cart-drawer__notice" role="alert" data-cart-notice hidden></p>
    <p class="visually-hidden" role="status" data-cart-status></p>

    <div
      class="cart-drawer__content"
      data-cart-drawer-content
      data-item-count="{{ cart.item_count }}"
      data-status="{{ 'cart.updated_status' | t: count: cart.item_count | escape }}"
      tabindex="-1"
    >
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p class="cart-drawer__empty-title">{{ 'cart.empty' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <ul class="cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            {%- assign item_alt = item.image.alt | default: item.product.title | escape -%}
            <li class="cart-line" data-line="{{ forloop.index }}">
              <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 240
                    | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: item_alt
                  }}
                {%- endif -%}
              </a>

              <div class="cart-line__info">
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                <p class="cart-line__price">
                  {{ item.final_price | money }}
                  {%- if item.original_price != item.final_price -%}
                    <s class="cart-line__price-original">{{ item.original_price | money }}</s>
                  {%- endif -%}
                </p>

                <div class="cart-line__controls">
                  <div class="quantity" role="group" aria-label="{{ 'cart.quantity' | t }}: {{ item.product.title | escape }}">
                    <button
                      class="quantity__button"
                      type="button"
                      data-cart-change
                      data-line="{{ forloop.index }}"
                      data-action="decrease"
                      data-quantity="{{ item.quantity | minus: 1 }}"
                      aria-label="{{ 'cart.decrease_quantity' | t }}: {{ item.product.title | escape }}"
                    >
                      {% render 'icon', name: 'minus' %}
                    </button>
                    <span class="quantity__value">{{ item.quantity }}</span>
                    <button
                      class="quantity__button"
                      type="button"
                      data-cart-change
                      data-line="{{ forloop.index }}"
                      data-action="increase"
                      data-quantity="{{ item.quantity | plus: 1 }}"
                      aria-label="{{ 'cart.increase_quantity' | t }}: {{ item.product.title | escape }}"
                    >
                      {% render 'icon', name: 'plus' %}
                    </button>
                  </div>
                  <button
                    class="cart-line__remove"
                    type="button"
                    data-cart-change
                    data-line="{{ forloop.index }}"
                    data-action="remove"
                    data-quantity="0"
                    aria-label="{{ 'cart.remove_item' | t }}: {{ item.product.title | escape }}"
                  >
                    {{- 'cart.remove' | t -}}
                  </button>
                </div>
              </div>

              <p class="cart-line__total">
                {{ item.final_line_price | money }}
                {%- if item.original_line_price != item.final_line_price -%}
                  <s class="cart-line__price-original">{{ item.original_line_price | money }}</s>
                {%- endif -%}
              </p>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-drawer__footer">
          <p class="cart-drawer__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </p>
          <p class="cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button class="button button--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          </form>
          <a class="cart-drawer__view" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
