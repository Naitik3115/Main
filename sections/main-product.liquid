{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_alt = product.featured_image.alt | default: product.title | escape
-%}

<section class="section container product">
  <div class="product__grid">
    <div class="product__media">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: product_alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>

    <div class="product__info">
      <h1 class="product__title">{{ product.title | escape }}</h1>

      <p class="product__price">
        {{ current_variant.price | money }}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="card__price-compare">{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </p>

      {%- form 'product', product, id: 'ProductForm', class: 'product__form', data-north-add-to-cart: '' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- else -%}
          <div class="field">
            <label class="field__label" for="VariantSelect">{{ 'products.variant' | t }}</label>
            <select class="select" id="VariantSelect" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                  {{- variant.title | escape }}{% unless variant.available %} &ndash; {{ 'products.sold_out' | t }}{% endunless %} &ndash; {{ variant.price | money -}}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <p class="product__error" role="alert" data-add-error hidden></p>

        <button class="button button--full" type="submit"{% unless current_variant.available %} disabled{% endunless %}>
          {%- if current_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": []
}
{% endschema %}
