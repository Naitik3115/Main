{%- paginate search.results by 12 -%}
  <section class="section container">
    <h1 class="page-title">{{ 'search.title' | t }}</h1>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">{{ 'search.title' | t }}</label>
      <input
        class="input"
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="muted">{{ 'search.results_count' | t: count: search.results_count }}</p>
        <ul class="grid" role="list">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a class="search-result" href="{{ item.url }}">{{ item.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {{- paginate | default_pagination -}}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'search.no_results' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search page",
  "settings": []
}
{% endschema %}
