{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
-%}

<section class="hero hero--{{ section.settings.height }} hero--{{ section.settings.alignment }}{% unless image %} hero--empty{% endunless %}">
  <div class="hero__media">
    {%- if image -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ image_mobile | image_url: width: 600 }} 600w, {{ image_mobile | image_url: width: 900 }} 900w, {{ image_mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
        >
        <img
          src="{{ image | image_url: width: 1600 }}"
          srcset="{{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 2000 }} 2000w, {{ image | image_url: width: 2800 }} 2800w"
          sizes="100vw"
          width="{{ image.width }}"
          height="{{ image.height }}"
          alt="{{ image.alt | escape }}"
          loading="{{ image_loading }}"
          fetchpriority="{{ image_priority }}"
        >
      </picture>
      <div class="hero__overlay" style="--hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__content container">
    <div class="hero__text">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="hero__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="hero__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to our store" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share what makes your store different in a sentence or two.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25,
      "info": "Darkens the image so the text stays readable."
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
