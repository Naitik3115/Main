<section class="section container cart">
  <h1 class="page-title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <p class="muted">{{ 'cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
  {%- else -%}
    <form class="cart__form" action="{{ routes.cart_url }}" method="post">
      <ul class="cart__items" role="list">
        {%- for item in cart.items -%}
          {%- assign item_alt = item.image.alt | default: item.product.title | escape -%}
          <li class="cart-item">
            <a class="cart-item__media" href="{{ item.url }}">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 240
                  | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: item_alt
                }}
              {%- endif -%}
            </a>
            <div class="cart-item__info">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="muted">{{ item.variant.title | escape }}</p>
              {%- endunless -%}
              <p class="muted">{{ item.final_price | money }}</p>
              <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <div class="cart-item__quantity">
              <label class="visually-hidden" for="Quantity-{{ forloop.index }}">
                {{- 'cart.quantity' | t }}: {{ item.product.title | escape -}}
              </label>
              <input
                class="input"
                id="Quantity-{{ forloop.index }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                inputmode="numeric"
              >
            </div>
            <p class="cart-item__total">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart__summary">
        <p class="cart__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </p>
        <p class="muted">{{ 'cart.taxes_note' | t }}</p>
        <div class="cart__actions">
          <button class="button button--secondary" type="submit" name="update">{{ 'cart.update' | t }}</button>
          <button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
