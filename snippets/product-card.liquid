{%- comment -%}
  Minimal product card shared by collection and search results.
  Accepts:
  - product: product object
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
{%- if product != blank -%}
  {%- assign card_alt = product.featured_image.alt | default: product.title | escape -%}
  <article class="card">
    <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            widths: '300, 450, 600, 800',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            alt: card_alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </a>
    <div class="card__body">
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      <p class="card__price">
        {%- if product.price_varies -%}{{ 'products.from' | t }} {% endif -%}
        {{ product.price | money }}
        {%- if product.compare_at_price > product.price -%}
          <s class="card__price-compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </p>
    </div>
  </article>
{%- endif -%}
